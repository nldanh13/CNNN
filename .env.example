# CNNN — optional hosted account authentication
# Create a Supabase project and enable Auth > Email signups.
# These two VITE_ variables are PUBLIC client configuration (not secrets).
# DO NOT use a Supabase service_role / secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Without both values, CNNN stays in its previous local-only mode.

# Optional: 'true' only AFTER running and verifying the RLS migration.
# Defaults to off to prevent accidentally uploading private data.
VITE_CLOUD_BACKUP_ENABLED=false
